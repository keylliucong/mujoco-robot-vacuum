<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic example. The chassis link frame is B. -->
<robot name="example_robot">
  <link name="body">
    <inertial>
      <origin xyz="0 0 0.052"/>
      <mass value="2.8"/>
      <inertia ixx="0.016" ixy="0" ixz="0" iyy="0.019" iyz="0" izz="0.029"/>
    </inertial>
    <collision>
      <origin xyz="0 0 0.057"/>
      <geometry><box size="0.28 0.22 0.07"/></geometry>
    </collision>
  </link>
  <link name="left_tire">
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.0000285866667" ixy="0" ixz="0" iyy="0.00005184" iyz="0" izz="0.0000285866667"/>
    </inertial>
    <collision>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.036" length="0.02"/></geometry>
    </collision>
  </link>
  <link name="right_tire">
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="0.0000285866667" ixy="0" ixz="0" iyy="0.00005184" iyz="0" izz="0.0000285866667"/>
    </inertial>
    <collision>
      <origin rpy="1.5707963267948966 0 0"/>
      <geometry><cylinder radius="0.036" length="0.02"/></geometry>
    </collision>
  </link>
  <link name="rear_support">
    <inertial>
      <mass value="0.04"/>
      <inertia ixx="0.0000016" ixy="0" ixz="0" iyy="0.0000016" iyz="0" izz="0.0000016"/>
    </inertial>
    <collision><geometry><sphere radius="0.01"/></geometry></collision>
  </link>
  <joint name="left_axle" type="continuous">
    <parent link="body"/>
    <child link="left_tire"/>
    <origin xyz="0 0.12 0.036"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="right_axle" type="continuous">
    <parent link="body"/>
    <child link="right_tire"/>
    <origin xyz="0 -0.12 0.036"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="support_mount" type="fixed">
    <parent link="body"/>
    <child link="rear_support"/>
    <origin xyz="-0.12 0 0.01"/>
  </joint>
</robot>
