        "kind": "flat",
        "heading_deg": 0,
        "start_offset_y_m": 0.0,
        "approach": {
          "speed_mps": 0.15,
          "start_distance_m": 0.5,
          "settle_s": 1.5,
          "settle_tol_mps": 0.02
        }
      },
      "max_time_s": 8.0
    },
    {
