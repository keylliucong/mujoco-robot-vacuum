{
  "schema_version": "1.0",
  "contract_version": "1.7.1",
  "batch_notes": "基准机型 oomwoo 的通用样机工况。结构来自 makerspet/oomwoo-one URDF（公开参考），数值来自 params/oomwoo.json，逐项带来源标签；目标机型未做本机实测，不得把本批结果写成产品越障能力。本批为单级台阶（带足够长度平台），obstacle.top_width_m 表示台面沿 x 的长度，不采用 IEC 62849 的 40 mm 矩形门槛顶宽。基准机型 oomwoo 的 12.5 mm 离地间隙意味着 20 mm 及以上门槛会先触发底盘接触；10 mm 工况用于观察轮-台阶接触时序。",
  "model": {
    "template_path": "models/baseline.xml",
    "template_sha256": "f2eeafdc6755d58d2fe7beffa26f37c4e5713562a6f66eb7fa13ed42fc244463",
    "params_path": "params/oomwoo.json",
    "params_sha256": "611bd5680edb5656302ed024fe5d6e6508f2aec156f4106cd90ab85e3fdc18a7",
    "config_id": "oomwoo_public_v1"
  },
  "judge": {
    "window_s": 8.0,
    "block_on": [
      "topple",
      "retreat",
      "timeout",
      "lift_fail",
      "slip_stall",
      "belly_contact"
    ],
    "min_advance_body_lengths": 1.0,
    "recover_speed_ratio": 0.8,
    "recover_hold_s": 0.3,
    "stall": {
      "speed_mps": 0.01,
      "duration_s": 1.0
    },
    "tilt": {
      "pitch_deg": 25.0,
      "roll_deg": 15.0
    },
    "slip_ratio": 0.3,
    "contact_normal_min_n": 0.5,
    "penetration_limit_m": 0.005,
    "approach_mean_distance_m": 0.2,
    "A1": {
      "coefficient": 0.02
    },
    "A2": {
      "abs_limit_m": 0.0005,
      "travel_frac_limit": 0.05
    },
    "A3": {
      "accel_limit_mps2": 0.05,
      "smooth_window_s": 0.1
    },
    "A4": {
      "steady_step_ratio": 0.05,
      "transient_step_ratio": 0.1,
      "min_torque_frac": 0.1,
      "transient_window_s": 0.5
    },
    "creep": {
      "settle_s": 1.5,
      "measure_s": 1.0,
      "drift_s": 10.0,
      "speed_limit_mps": 0.001,
      "drift_limit_m": 0.0005
    }
  },
  "cases": [
